---
// プレビュー用コメント機能（画面側）。src/site.ts の indexable が false のあいだだけ表示する。
// 保存先は api/comments.js（GitHub の Issues）。
---
<div id="rv-host" data-nosnippet></div>
<script>
  type Anchor = { selector: string; x: number | null; y: number | null; docX: number | null; docY: number | null };
  type Comment = {
    id: number; name: string; text: string; page: string; lang: string; width: number;
    snippet?: string; anchor: Anchor; created: string; url: string;
  };

  const host = document.getElementById('rv-host')!;
  const w = window as any;
  // 自動チェックツール（Playwright）では表示しない（試作との比較がずれるため）
  if (navigator.webdriver && !w.__review) host.remove();
  else init();

  function init() {
    const ja = document.documentElement.lang === 'ja';
    const T = ja
      ? {
          comment: 'コメント', list: '一覧', cancel: 'やめる', send: '送信', close: '閉じる', resolve: '解決',
          pick: 'コメントしたい場所をクリックしてください（Escでやめる）',
          placeholder: 'ここをこう変えてほしい、など', setupTitle: 'コメント機能を使う',
          name: 'お名前', start: 'はじめる', none: 'まだコメントはありません',
          thisPage: 'このページ', other: 'ほかのページ', confirmResolve: 'このコメントを「解決」にして消しますか？', del: '削除', confirmDelete: 'このコメントを削除しますか？（元に戻せません）',
          notReady: 'コメント機能の設定がまだ終わっていません',
          failed: 'うまくいきませんでした。時間をおいてもう一度お試しください', sending: '送信中…',
          screen: '画面幅', change: '名前を変える', missingPin: '（場所が見つかりません）',
        }
      : {
          comment: 'Comment', list: 'All', cancel: 'Cancel', send: 'Post', close: 'Close', resolve: 'Resolve',
          pick: 'Click where you want to comment (Esc to cancel)',
          placeholder: 'What should change here?', setupTitle: 'Leave review comments',
          name: 'Your name', start: 'Start', none: 'No comments yet',
          thisPage: 'This page', other: 'Other pages', confirmResolve: 'Mark this comment as resolved and hide it?', del: 'Delete', confirmDelete: 'Delete this comment? This cannot be undone.',
          notReady: 'Comments are not set up yet',
          failed: 'Something went wrong. Please try again later.', sending: 'Posting…',
          screen: 'width', change: 'Change name', missingPin: '(location not found)',
        };

    // ---- 保存（ブラウザ内） ----
    const store = {
      get(k: string) { try { return localStorage.getItem('rv-' + k) || ''; } catch { return ''; } },
      set(k: string, v: string) { try { localStorage.setItem('rv-' + k, v); } catch {} },
    };
    let name = store.get('name');
    // このブラウザから送ったコメントの番号（自分のコメントだけ削除できる）
    const myIds = new Set<number>((() => { try { return JSON.parse(store.get('mine') || '[]'); } catch { return []; } })());
    const saveMine = () => store.set('mine', JSON.stringify([...myIds]));

    // ---- 画面の部品（Shadow DOM でサイトのCSSと切り離す） ----
    const root = host.attachShadow({ mode: 'open' });
    root.innerHTML = `<style>
      :host{all:initial}
      *{box-sizing:border-box;font-family:"Zen Kaku Gothic New",system-ui,sans-serif}
      .layer{position:absolute;left:0;top:0;width:0;height:0;z-index:2147483000}
      .bar{position:fixed;right:16px;bottom:16px;display:flex;gap:6px;z-index:2147483001}
      button{font:inherit;font-size:14px;font-weight:700;border:0;border-radius:999px;padding:10px 16px;cursor:pointer;
        background:#1E4B6C;color:#fff;box-shadow:0 4px 14px rgba(0,0,0,.25);line-height:1.2}
      button.sub{background:#fff;color:#1E4B6C;border:1.5px solid #1E4B6C}
      button.ghost{background:none;box-shadow:none;color:#555;padding:8px 10px;font-weight:500}
      button.warn{background:#932E3C}
      .count{display:inline-block;min-width:20px;margin-left:6px;padding:1px 6px;border-radius:999px;background:#83B6DD;color:#0d2a40;font-size:12px}
      .tip{position:fixed;left:50%;bottom:72px;pointer-events:none;transform:translateX(-50%);background:#1b1b1b;color:#fff;padding:10px 16px;border-radius:8px;
        font-size:14px;z-index:2147483002;max-width:calc(100vw - 32px);text-align:center}
      .hl{position:absolute;border:2px dashed #932E3C;background:rgba(147,46,60,.06);pointer-events:none;border-radius:3px}
      .pin{position:absolute;transform:translate(-50%,-100%);min-width:30px;height:30px;padding:0 8px;border-radius:15px 15px 15px 2px;
        background:#932E3C;color:#fff;font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center;
        cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.35);border:2px solid #fff;pointer-events:auto}
      .pin.on{background:#1E4B6C}
      .card{position:absolute;width:min(330px,calc(100vw - 24px));background:#fff;color:#1b1b1b;border-radius:10px;padding:14px;
        box-shadow:0 10px 34px rgba(0,0,0,.3);font-size:14px;line-height:1.6;pointer-events:auto;z-index:2147483002}
      .card.fixed{position:fixed}
      .card h3{margin:0 0 8px;font-size:15px}
      .card textarea,.card input{width:100%;font:inherit;font-size:14px;border:1px solid #bbb;border-radius:6px;padding:8px;margin:0 0 8px;color:#1b1b1b;background:#fff}
      .card textarea{min-height:96px;resize:vertical}
      .card label{display:block;font-size:12px;color:#555}
      .row{display:flex;justify-content:flex-end;gap:6px;align-items:center;flex-wrap:wrap}
      .row button{box-shadow:none;padding:8px 14px}
      .text{white-space:pre-wrap;word-break:break-word;margin:0 0 8px}
      .meta{font-size:12px;color:#666;margin:0 0 10px}
      .err{color:#932E3C;font-size:13px;margin:0 0 8px}
      .panel{position:fixed;right:16px;bottom:72px;width:min(380px,calc(100vw - 32px));max-height:min(70vh,600px);overflow:auto}
      .panel h4{margin:12px 0 4px;font-size:12px;color:#666;font-weight:500}
      .panel a{display:block;color:#1b1b1b;text-decoration:none;padding:8px;border-radius:6px;border:1px solid #eee;margin:0 0 6px}
      .panel a:hover{background:#f3f6f9}
      .panel a b{color:#932E3C;margin-right:6px}
      .panel small{display:block;color:#666;font-size:11px}
    </style>
    <div class="layer"></div>
    <div class="bar"><button class="sub" data-act="list">${T.list}<span class="count">0</span></button><button data-act="new">💬 ${T.comment}</button></div>`;
    const layer = root.querySelector('.layer') as HTMLElement;
    const countEl = root.querySelector('.count') as HTMLElement;

    const el = (tag: string, cls = '', text = '') => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    };
    let openCard: HTMLElement | null = null;
    const closeCard = () => { openCard?.remove(); openCard = null; root.querySelectorAll('.pin.on').forEach((p) => p.classList.remove('on')); };
    const showCard = (card: HTMLElement, x?: number, y?: number) => {
      closeCard();
      openCard = card;
      if (x === undefined || y === undefined) { card.classList.add('fixed'); root.appendChild(card); return; }
      layer.appendChild(card);
      const cw = Math.min(330, innerWidth - 24);
      card.style.left = Math.max(scrollX + 12, Math.min(x - 20, scrollX + innerWidth - cw - 12)) + 'px';
      card.style.top = y + 12 + 'px';
      const r = card.getBoundingClientRect();
      if (r.bottom > innerHeight - 70) card.style.top = Math.max(scrollY + 8, y - r.height - 40) + 'px';
    };

    // ---- サーバーとのやりとり ----
    async function api(method: 'GET' | 'POST', body?: object) {
      const r = await fetch('/api/comments', {
        method,
        headers: body ? { 'Content-Type': 'application/json' } : {},
        body: body ? JSON.stringify(body) : undefined,
      });
      let data: any = {};
      try { data = await r.json(); } catch {}
      if (!r.ok) throw Object.assign(new Error(data.error || 'error'), { status: r.status });
      return data;
    }
    const errText = (e: any) => (e.status === 503 || e.status === 404 ? T.notReady : T.failed);

    // ---- 名前（初回だけ） ----
    function setup(then?: () => void) {
      const c = el('div', 'card');
      c.append(el('h3', '', T.setupTitle));
      const l1 = el('label', '', T.name); const i1 = el('input') as HTMLInputElement; i1.value = name; i1.autocomplete = 'name';
      const err = el('p', 'err'); err.hidden = true;
      const row = el('div', 'row');
      const cancel = el('button', 'ghost', T.cancel); const ok = el('button', '', T.start);
      row.append(cancel, ok);
      c.append(l1, i1, err, row);
      c.style.right = '16px'; c.style.bottom = '72px';
      showCard(c);
      i1.focus();
      cancel.onclick = closeCard;
      const go = () => {
        if (!i1.value.trim()) return;
        name = i1.value.trim(); store.set('name', name);
        closeCard();
        then?.();
      };
      ok.onclick = go;
      i1.onkeydown = (e) => { if (e.key === 'Enter') go(); };
    }

    // ---- コメントの印 ----
    let comments: Comment[] = [];
    const here = location.pathname;
    const pinPos = (a: Anchor) => {
      if (a.selector) {
        let t: Element | null = null;
        try { t = document.querySelector(a.selector); } catch {}
        if (t) {
          const r = t.getBoundingClientRect();
          if (r.width || r.height) {
            return { x: r.left + scrollX + (a.x ?? 0.5) * r.width, y: r.top + scrollY + (a.y ?? 0.5) * r.height };
          }
        }
      }
      if (a.docY != null) return { x: (a.docX ?? 0.5) * document.documentElement.clientWidth, y: a.docY };
      return null;
    };
    function draw() {
      layer.querySelectorAll('.pin:not(.tmp)').forEach((p) => p.remove());
      const mine = comments.filter((c) => c.page === here);
      countEl.textContent = String(comments.length);
      for (const c of mine) {
        const p = pinPos(c.anchor);
        if (!p) continue;
        const pin = el('div', 'pin', String(c.id));
        pin.dataset.id = String(c.id);
        pin.style.left = p.x + 'px'; pin.style.top = p.y + 'px';
        pin.onclick = (e) => { e.stopPropagation(); showComment(c); };
        layer.appendChild(pin);
      }
    }
    const fmtDate = (s: string) => new Date(s).toLocaleString(ja ? 'ja-JP' : 'en-GB', { dateStyle: 'medium', timeStyle: 'short' });
    function showComment(c: Comment) {
      const p = pinPos(c.anchor);
      const card = el('div', 'card');
      card.append(el('p', 'text', c.text));
      card.append(el('p', 'meta', `#${c.id} ${c.name} ・ ${fmtDate(c.created)} ・ ${c.lang.toUpperCase()} ${T.screen} ${c.width}px`));
      const err = el('p', 'err'); err.hidden = true; card.append(err);
      const row = el('div', 'row');
      const close = el('button', 'ghost', T.close); const res = el('button', 'warn', '✓ ' + T.resolve);
      row.append(close);
      if (myIds.has(c.id)) {
        const del = el('button', 'sub', T.del);
        row.append(del);
        del.onclick = async () => {
          if (!confirm(T.confirmDelete)) return;
          del.disabled = true;
          try {
            await api('POST', { action: 'delete', id: c.id, name });
            myIds.delete(c.id); saveMine();
            comments = comments.filter((x) => x.id !== c.id); closeCard(); draw();
          } catch (e) { err.textContent = errText(e); err.hidden = false; del.disabled = false; }
        };
      }
      row.append(res); card.append(row);
      close.onclick = closeCard;
      res.onclick = async () => {
        if (!confirm(T.confirmResolve)) return;
        res.disabled = true;
        try {
          await api('POST', { action: 'resolve', id: c.id, name });
          comments = comments.filter((x) => x.id !== c.id); closeCard(); draw();
        } catch (e) { err.textContent = errText(e); err.hidden = false; res.disabled = false; }
      };
      if (p) {
        showCard(card, p.x, p.y);
        layer.querySelector(`.pin[data-id="${c.id}"]`)?.classList.add('on');
        const top = p.y - scrollY;
        if (top < 80 || top > innerHeight - 120) scrollTo({ top: p.y - innerHeight / 3, behavior: 'smooth' });
      } else {
        card.prepend(el('p', 'meta', T.missingPin));
        card.style.right = '16px'; card.style.bottom = '72px';
        showCard(card);
      }
    }

    // ---- 一覧 ----
    function showList() {
      const card = el('div', 'card panel');
      const mine = comments.filter((c) => c.page === here);
      const others = comments.filter((c) => c.page !== here);
      if (!comments.length) card.append(el('p', 'meta', T.none));
      const group = (title: string, list: Comment[]) => {
        if (!list.length) return;
        card.append(el('h4', '', title));
        for (const c of list) {
          const a = el('a') as HTMLAnchorElement;
          a.href = c.page + '#rv-' + c.id;
          const b = el('b', '', '#' + c.id);
          a.append(b, document.createTextNode(c.text.length > 80 ? c.text.slice(0, 80) + '…' : c.text));
          a.append(el('small', '', `${c.name} ・ ${c.page} ・ ${T.screen} ${c.width}px`));
          if (c.page === here) a.onclick = (e) => { e.preventDefault(); showComment(c); };
          card.append(a);
        }
      };
      group(T.thisPage, mine);
      group(T.other, others);
      const row = el('div', 'row');
      const ch = el('button', 'ghost', T.change); ch.onclick = () => setup();
      const close = el('button', 'sub', T.close); close.onclick = closeCard;
      row.append(ch, close); card.append(row);
      showCard(card);
    }

    // ---- 場所を選んでコメントを書く ----
    let picking = false;
    let tip: HTMLElement | null = null;
    const hl = el('div', 'hl');
    const outside = (e: Event) => !e.composedPath().includes(host);
    function selectorFor(t: Element) {
      const parts: string[] = [];
      let n: Element | null = t;
      while (n && n !== document.body && n !== document.documentElement) {
        if (n.id && document.querySelectorAll('#' + CSS.escape(n.id)).length === 1) { parts.unshift('#' + CSS.escape(n.id)); return parts.join(' > '); }
        const tag = n.tagName.toLowerCase();
        const same = n.parentElement ? [...n.parentElement.children].filter((s) => s.tagName === n!.tagName) : [];
        parts.unshift(same.length > 1 ? `${tag}:nth-of-type(${same.indexOf(n) + 1})` : tag);
        n = n.parentElement;
      }
      return 'body > ' + parts.join(' > ');
    }
    function startPick() {
      closeCard();
      picking = true;
      document.documentElement.style.cursor = 'crosshair';
      tip = el('div', 'tip', T.pick); root.appendChild(tip);
    }
    function stopPick() {
      picking = false;
      document.documentElement.style.cursor = '';
      tip?.remove(); tip = null; hl.remove();
    }
    document.addEventListener('mousemove', (e) => {
      if (!picking || !outside(e)) return;
      const t = e.target as Element;
      const r = t.getBoundingClientRect();
      Object.assign(hl.style, { left: r.left + scrollX + 'px', top: r.top + scrollY + 'px', width: r.width + 'px', height: r.height + 'px' });
      if (!hl.isConnected) layer.appendChild(hl);
    }, true);
    const block = (e: Event) => { if (picking && outside(e)) { e.preventDefault(); e.stopPropagation(); } };
    ['mousedown', 'mouseup', 'pointerdown', 'pointerup'].forEach((t) => document.addEventListener(t, block, { capture: true, passive: false } as any));
    document.addEventListener('click', (e) => {
      if (!picking) { if (openCard && outside(e) && !openCard.classList.contains('fixed')) closeCard(); return; }
      if (!outside(e)) return;
      e.preventDefault(); e.stopPropagation();
      const t = e.target as Element;
      const r = t.getBoundingClientRect();
      const docX = e.pageX, docY = e.pageY;
      const anchor: Anchor = {
        selector: selectorFor(t),
        x: r.width ? (e.clientX - r.left) / r.width : null,
        y: r.height ? (e.clientY - r.top) / r.height : null,
        docX: docX / document.documentElement.clientWidth,
        docY,
      };
      const snippet = (t.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 60);
      stopPick();
      compose(anchor, snippet, docX, docY);
    }, true);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { if (picking) stopPick(); else closeCard(); }
    });

    function compose(anchor: Anchor, snippet: string, x: number, y: number) {
      const card = el('div', 'card');
      const ta = el('textarea') as HTMLTextAreaElement; ta.placeholder = T.placeholder;
      const err = el('p', 'err'); err.hidden = true;
      const row = el('div', 'row');
      const cancel = el('button', 'ghost', T.cancel); const send = el('button', '', T.send);
      row.append(cancel, send);
      card.append(ta, err, row);
      const temp = el('div', 'pin on tmp', '+');
      temp.style.left = x + 'px'; temp.style.top = y + 'px';
      layer.appendChild(temp);
      showCard(card, x, y);
      const cleanup = () => { temp.remove(); };
      cancel.onclick = () => { cleanup(); closeCard(); };
      ta.focus({ preventScroll: true });
      send.onclick = async () => {
        const text = ta.value.trim();
        if (!text) return;
        send.disabled = true; send.textContent = T.sending;
        try {
          const d = await api('POST', {
            name, text, page: here, lang: ja ? 'ja' : 'en', width: innerWidth, snippet, anchor,
          });
          comments.push(d.comment); myIds.add(d.comment.id); saveMine(); cleanup(); closeCard(); draw();
        } catch (e) {
          err.textContent = errText(e); err.hidden = false; send.disabled = false; send.textContent = T.send;
        }
      };
      ta.onkeydown = (e) => { if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) send.click(); };
      // 閉じたときに仮の印を消す
      const obs = new MutationObserver(() => { if (!card.isConnected) { cleanup(); obs.disconnect(); } });
      obs.observe(layer, { childList: true });
      obs.observe(root, { childList: true });
    }

    // ---- ボタン ----
    root.querySelector('[data-act="new"]')!.addEventListener('click', () => {
      if (picking) return stopPick();
      if (!name) return setup(startPick);
      startPick();
    });
    root.querySelector('[data-act="list"]')!.addEventListener('click', () => {
      if (openCard?.classList.contains('panel')) return closeCard();
      showList();
    });

    // ---- 位置の更新（画面幅の変更・画像や文字の読み込み後） ----
    let raf = 0;
    const redraw = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(draw); };
    addEventListener('resize', redraw);
    addEventListener('load', redraw);
    new ResizeObserver(redraw).observe(document.body);

    // ---- 起動時に読み込む ----
    api('GET').then((d) => {
      comments = d.comments; draw();
      const m = location.hash.match(/^#rv-(\d+)$/);
      if (m) { const c = comments.find((x) => x.id === Number(m[1])); if (c) setTimeout(() => showComment(c), 300); }
    }).catch(() => {});
  }
</script>
